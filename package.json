{
  "name": "cw-ai-ebooking-front",
  "private": true,
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "vite",
    "build": "yarn type-check && yarn build-only",
    "preview": "vite preview",
    "build-only": "vite build",
    "build:uat": "yarn type-check && yarn build-only --mode uat",
    "build:sit": "yarn type-check && yarn build-only --mode sit",
    "build:prd": "yarn type-check && yarn build-only --mode prd",
    "build:demo_logisofts": "yarn type-check && yarn build-only --mode demo_logisofts",
    "type-check": "vue-tsc --noEmit",
    "vite:hook": "tsx scripts/vite-runner.js",
    "lint": "eslint . --fix --ignore-pattern \"src/components/DataTableFilter.vue\"",
    "build:test": "yarn type-check && yarn build-only --mode test",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fontsource/inter": "5.2.8",
    "@mdi/font": "^7.4.47",
    "@microsoft/signalr": "^8.0.17",
    "@tiptap/core": "^3.24.0",
    "@tiptap/extension-image": "^3.24.0",
    "@tiptap/extension-link": "^3.24.0",
    "@tiptap/extension-table": "^3.24.0",
    "@tiptap/extension-table-cell": "^3.24.0",
    "@tiptap/extension-table-header": "^3.24.0",
    "@tiptap/extension-table-row": "^3.24.0",
    "@tiptap/starter-kit": "^3.24.0",
    "@tiptap/vue-3": "^3.24.0",
    "apexcharts": "^5.13.0",
    "axios": "^1.16.1",
    "decimal.js": "^10.6.0",
    "js-md5": "^0.8.3",
    "ol": "^10.9.0",
    "pinia": "^3.0.4",
    "vue": "^3.5.35",
    "vue-i18n": "^11.4.4",
    "vue-router": "^4.6.4",
    "vue3-apexcharts": "^1.11.1",
    "vuedraggable": "^4.1.0",
    "vuetify": "^3.12.7"
  },
  "devDependencies": {
    "@tsconfig/node22": "^22.0.5",
    "@types/node": "^25.9.1",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/compiler-sfc": "^3.5.35",
    "@vue/test-utils": "^2.4.10",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^9.39.4",
    "eslint-config-vuetify": "^4.6.2",
    "happy-dom": "^20.9.0",
    "npm-run-all2": "^9.0.1",
    "openapi-typescript-codegen": "0.30.0",
    "rollup-plugin-visualizer": "^7.0.1",
    "sass-embedded": "^1.100.0",
    "tsx": "^4.22.4",
    "typescript": "~5.9.3",
    "unplugin-auto-import": "^21.0.0",
    "unplugin-vue-components": "^32.1.0",
    "unplugin-vue-router": "^0.19.2",
    "vite": "^7.3.3",
    "vite-plugin-compression": "^0.5.1",
    "vite-plugin-vue-layouts-next": "^2.1.0",
    "vite-plugin-vuetify": "^2.1.3",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.3.3"
  },
  "engines": {
    "node": ">=22.22.3"
  }
}
