{
  "name": "first-cargo-ebooking",
  "private": true,
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "vite",
    "build": "yarn type-check && yarn build-only",
    "preview": "vite preview",
    "build-only": "vite build",
    "build:uat": "yarn type-check && yarn build-only --mode uat",
    "build:sit": "yarn type-check && yarn build-only --mode sit",
    "build:prd": "yarn type-check && yarn build-only --mode prd",
    "type-check": "vue-tsc --noEmit",
    "lint": "eslint . --fix --ignore-pattern \"src/components/DataTableFilter.vue\"",
    "build:test": "yarn type-check && yarn build-only --mode test",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fontsource/inter": "5.2.8",
    "@fontsource/roboto": "5.2.9",
    "@mdi/font": "7.4.47",
    "@microsoft/signalr": "^8.0.17",
    "@tiptap/core": "^3.20.4",
    "@tiptap/extension-image": "^3.20.4",
    "@tiptap/extension-link": "^3.20.4",
    "@tiptap/extension-table": "^3.20.4",
    "@tiptap/extension-table-cell": "^3.20.4",
    "@tiptap/extension-table-header": "^3.20.4",
    "@tiptap/extension-table-row": "^3.20.4",
    "@tiptap/starter-kit": "^3.20.4",
    "@tiptap/vue-3": "^3.20.4",
    "apexcharts": "^5.3.6",
    "axios": "^1.13.2",
    "decimal.js": "^10.6.0",
    "ol": "^10.7.0",
    "pinia": "^3.0.4",
    "vue": "^3.5.27",
    "vue-i18n": "^11.2.8",
    "vue-router": "^4.6.4",
    "vue3-apexcharts": "^1.10.0",
    "vuedraggable": "^4.1.0",
    "vuetify": "^3.11.8"
  },
  "devDependencies": {
    "@tsconfig/node22": "^22.0.5",
    "@types/node": "^25.0.9",
    "@vitejs/plugin-vue": "^6.0.3",
    "@vue/compiler-sfc": "^3.5.27",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.8.1",
    "eslint": "^9.39.2",
    "eslint-config-vuetify": "^4.3.4",
    "happy-dom": "^15.11.4",
    "npm-run-all2": "^8.0.4",
    "sass-embedded": "^1.97.2",
    "typescript": "~5.9.3",
    "unplugin-auto-import": "^21.0.0",
    "unplugin-fonts": "^1.4.0",
    "unplugin-vue-components": "^31.0.0",
    "unplugin-vue-router": "^0.19.2",
    "vite": "^7.3.1",
    "vite-plugin-compression": "^0.5.1",
